{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ksiegai-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "durable_objects": {
    "bindings": [{ "name": "KsiegaiMcp", "class_name": "KsiegaiMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KsiegaiMcp"] }],

  // Worker-to-worker, no public hop — reuses ksiegai-gateway's existing
  // service/repo layer (RLS, requireSession, posting/COA logic) instead of
  // this Worker touching Postgres or re-implementing anything.
  "services": [{ "binding": "GATEWAY", "service": "ksiegai-gateway" }],

  // OAuth auto-connect (T-418 continuation, 2026-08-15): @cloudflare/workers-oauth-provider's
  // grant/token/pending-authorize-request store. Placeholder id — before a
  // real deploy, run `wrangler kv namespace create ksiegai-mcp-oauth-kv`
  // and replace "id" below. `wrangler dev` (local mode) doesn't need a real
  // provisioned namespace to run — it simulates KV locally regardless.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID" }],

  // Where the OAuth /authorize handler redirects the browser to for the
  // actual login + business/tier consent screen (McpAuthorize.tsx in
  // ksef-ai) — see src/oauth.ts. Not a secret; overridable via .dev.vars
  // for local dev against a local ksef-ai dev server.
  "vars": {
    "APP_AUTHORIZE_URL": "https://app.ksiegai.pl/settings/ai-mcp/authorize"
  },

  "routes": [{ "pattern": "mcp.ksiegai.pl", "custom_domain": true }],
  "workers_dev": true,

  // Default inspector port (9229) collides with ksiegai-gateway's own dev
  // inspector when both wrangler dev processes run at once locally.
  "dev": { "inspector_port": 9230 }
}
